{
  "name": "linie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A blueprint-inspired network operations template built with React and MVVM.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "biome check . --error-on-warnings",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run typecheck"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@radix-ui/themes": "3.3.0",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
