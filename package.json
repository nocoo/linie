{
  "name": "linie",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "description": "A blueprint-inspired network operations template built with React and MVVM.",
  "scripts": {
    "dev": "cf dev",
    "build": "tsc -b && cf build",
    "deploy": "npm run check && npm run build && cf deploy --prebuilt --mode production",
    "deploy:dry-run": "npm run build && cf deploy --prebuilt --dry-run --mode production",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "biome check . --error-on-warnings",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify:deployment": "node scripts/verify-production.ts"
  },
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || >=26.12.0"
  },
  "dependencies": {
    "@radix-ui/themes": "3.3.0",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "cf": "1.0.0-beta.26",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
